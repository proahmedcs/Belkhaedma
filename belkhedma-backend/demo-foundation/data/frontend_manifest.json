    { "id": "hourly_package_selection", "path": "/pages/hourly/package-selection.html", "journey_group": "hourly" },
    { "id": "hourly_visit_schedule", "path": "/pages/hourly/visit-schedule.html", "journey_group": "hourly" },
    { "id": "hourly_complete_data", "path": "/pages/hourly/complete-data.html", "journey_group": "hourly" },
    { "id": "hourly_contract_preview", "path": "/pages/hourly/contract-preview.html", "journey_group": "hourly" },
    { "id": "hourly_payment", "path": "/pages/hourly/payment.html", "journey_group": "hourly" },
